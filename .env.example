# ==========================================
# Токен бота из @BotFather в Telegram
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Ваш цифровой Telegram ID (необязательно, можно узнать в @userinfobot)
# Если указан, дает права администратора даже до подключения Telegram Business
OWNER_ID=

# ==========================================
# Настройки сохранения сообщений
# ==========================================
# Сохранять ли вложения (фото, голосовые, видео, кружочки, файлы)? (true/false)
SAVE_MEDIA=true

# Максимальный размер сохраняемого медиафайла в МБ
MAX_MEDIA_SIZE_MB=20

# Уведомлять об отредактированных сообщениях (покажет старый и новый текст) (true/false)
LOG_EDITED=true

# Через сколько дней автоматически удалять старые записи и медиа (очистка диска)
RETENTION_DAYS=7

# ==========================================
# Перехват исчезающих/любых фото по ответу
# ==========================================
# Перехватывать фото/медиа при свайпе (ответе) на сообщение в чате (true/false)
SAVE_MEDIA_ON_REPLY=true

# Триггерное слово для перехвата (оставьте ПУСТЫМ, чтобы срабатывало на ЛЮБОЙ ответ, например просто точку)
# Если хотите перехватывать только по специальному слову, укажите например: . или ! или сохрани
REPLY_TRIGGER_KEYWORD=
